{
  "name": "washq-app",
  "version": "1.0.0",
  "private": true,
  "description": "WashQ - ระบบจองคิวเครื่องซักผ้าอัจฉริยะสำหรับหอพักนักศึกษา",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "npm run dev --prefix api",
    "dev:frontend": "npm run dev --prefix frontend",
    "api": "npm run dev --prefix api",
    "frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix api && npm install --prefix frontend",
    "db:init": "node api/scripts/init-db.js",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "start": "npm run start --prefix api"
  },
  "keywords": [
    "washq",
    "laundry-queue",
    "react",
    "express",
    "socket.io",
    "mysql"
